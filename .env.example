# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public site URL for canonical metadata and social previews.
NEXT_PUBLIC_SITE_URL="https://rangeloviedo.com"

# Rangel Oviedo Group conversion links powered by GoHighLevel.
# Use the direct URLs when embedding is not desired.
NEXT_PUBLIC_GHL_FORM_URL=""
NEXT_PUBLIC_GHL_CALENDAR_URL=""

# Optional iframe/embed URLs for the final conversion section.
NEXT_PUBLIC_GHL_FORM_EMBED_URL=""
NEXT_PUBLIC_GHL_CALENDAR_EMBED_URL=""

# HAR.com IDX integration (Houston MLS).
# Widget URL for the full MLS search ("All MLS Listings / Home Finder"),
# generated from the HAR Platinum panel: har.com/mopx_platinum/idx_tools
# While empty, /buscar shows an on-brand placeholder with instructions.
NEXT_PUBLIC_HAR_IDX_WIDGET_URL=""
# Widget URL for the agent's own auto-updating catalog ("View My Listings").
# Feeds the full-catalog section on /propiedades. While empty it shows a placeholder.
NEXT_PUBLIC_HAR_MY_LISTINGS_URL=""
# Widget URL for the agent's SOLD listings ("View My Sold Listings"), used as a
# track-record showcase on /propiedades. While empty it shows a placeholder.
NEXT_PUBLIC_HAR_SOLD_LISTINGS_URL=""
# Legal broker of record name, shown in the IDX disclaimer.
# Leave empty to use the default "Rangel Oviedo Group".
NEXT_PUBLIC_HAR_BROKER_NAME=""

# Optional secondary WhatsApp channel. International format, no + or spaces.
NEXT_PUBLIC_RANGEL_WHATSAPP=""

# Optional fallback contact info shown in the footer when GHL is not yet configured.
# Leave empty to hide that footer block entirely.
NEXT_PUBLIC_RANGEL_EMAIL=""
NEXT_PUBLIC_RANGEL_PHONE=""

# Optional MP4 background for the contact section. Leave empty for the static fallback.
# Example: /videos/contacto.mp4
NEXT_PUBLIC_CONTACTO_BG_VIDEO=""
